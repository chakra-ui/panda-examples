{
  "name": "pandacn",
  "version": "0.1.1",
  "description": "shadcn/ui modeled as a Panda CSS design system, shipped with `panda lib`.",
  "keywords": [
    "design-system",
    "panda-css",
    "react",
    "shadcn"
  ],
  "homepage": "https://github.com/chakra-ui/panda-examples/tree/main/examples/monorepo/packages/ds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chakra-ui/panda-examples.git",
    "directory": "examples/monorepo/packages/ds"
  },
  "files": [
    "dist",
    "styled-system",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.js"
    },
    "./recipes/*": {
      "types": "./styled-system/recipes/*.d.ts",
      "default": "./styled-system/recipes/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codegen": "panda codegen",
    "lib": "panda codegen && panda lib",
    "css": "panda cssgen --outfile dist/styles.css",
    "build": "pnpm codegen && pnpm lib && pnpm css",
    "prepack": "pnpm build",
    "clean": "rm -rf dist styled-system"
  },
  "devDependencies": {
    "@pandacss/dev": "2.0.0-beta.15",
    "@pandacss/preset-base": "2.0.0-beta.15",
    "@pandacss/preset-panda": "2.0.0-beta.15",
    "@types/react": "19.2.7",
    "react": "19.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
